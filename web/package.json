{
  "name": "odin-web",
  "private": true,
  "version": "0.0.0",
  "description": "Odin web app synthetic prototype (not connected to Odin's service)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5317 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5318 --strictPort",
    "browsers:install": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright install chromium",
    "test": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test",
    "test:perf": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test -c playwright.perf.config.js",
    "test:unit": "node --test tests-unit/",
    "describe:large": "node scripts/describe-large.mjs"
  },
  "dependencies": {
    "d3-hierarchy": "3.1.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "vite": "8.3.5"
  }
}
