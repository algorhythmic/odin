{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "label": {
      "const": "fake-backend evidence"
    },
    "result": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "label",
    "result"
  ],
  "additionalProperties": false
}
