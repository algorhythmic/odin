{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:development-loop-job:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "loop_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "state": {
      "enum": [
        "pending",
        "running",
        "completed",
        "cancelled",
        "unknown",
        "lost",
        "blocked"
      ]
    },
    "packet": {
      "type": "object"
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "id",
    "loop_id",
    "project",
    "state",
    "packet",
    "packet_digest",
    "result",
    "failure_reason",
    "created_at"
  ],
  "additionalProperties": false
}
