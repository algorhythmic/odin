{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "revision",
          "content",
          "gap"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "checkpoint",
    "records"
  ],
  "additionalProperties": false
}
