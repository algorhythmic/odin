{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "active",
        "idle",
        "retired"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "assignment": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "assignment_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "failed"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "evidence",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "const": "fixture-only; no model or tool execution"
    }
  },
  "required": [
    "session",
    "state",
    "generation",
    "assignment",
    "assignment_revision",
    "operation_id",
    "result",
    "label"
  ],
  "additionalProperties": false
}
