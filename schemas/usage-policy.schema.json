{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mode", "missing_telemetry", "account_id", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["observe", "hold"]},
    "missing_telemetry": {"enum": ["observe", "hold"]},
    "account_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_tokens", "max_output_tokens", "max_requests", "max_context_tokens", "max_five_hour_used_percentage", "max_seven_day_used_percentage", "max_sample_age_seconds"],
      "properties": {
        "max_input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "max_requests": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "max_context_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "max_five_hour_used_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "max_seven_day_used_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "max_sample_age_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400}
      }
    }
  }
}
