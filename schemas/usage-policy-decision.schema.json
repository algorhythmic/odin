{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "operation_id", "purpose", "loop_id", "stage_id", "evaluated_at", "mode", "decision", "reasons", "observed"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 256},
    "loop_id": {"type": ["string", "null"], "maxLength": 256},
    "stage_id": {"type": ["string", "null"], "maxLength": 256},
    "session_id": {"type": ["string", "null"], "maxLength": 256},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["observe", "hold"]},
    "configured": {"type": "boolean"},
    "decision": {"enum": ["allow", "hold"]},
    "reasons": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "limit_bands": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "utilization_percent", "observed_at", "band"],
      "properties": {
        "label": {"type": "string", "pattern": "^(claude|codex)\\.[a-z0-9_.]{1,64}$"},
        "utilization_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "observed_at": {"type": "string", "format": "date-time"},
        "band": {"enum": ["clear", "wind_down", "ordinary_stop", "handoff_only"]}
      }
    }},
    "observed": {
      "type": "object", "additionalProperties": false,
      "required": ["request_count", "cache_inclusive_input_tokens", "output_tokens", "context_input_tokens", "five_hour_used_percentage", "seven_day_used_percentage", "quota_observed_at", "coverage_complete", "quota_stale"],
      "properties": {
        "request_count": {"type": "integer", "minimum": 0},
        "cache_inclusive_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "context_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "five_hour_used_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "seven_day_used_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "quota_observed_at": {"type": ["string", "null"]},
        "coverage_complete": {"type": "boolean"},
        "quota_stale": {"type": "boolean"},
        "context_stale": {"type": "boolean"}
      }
    }
  }
}
