{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "incarnation": {
      "type": "integer",
      "minimum": 1
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "server_incarnation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "pane": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "state": {
      "enum": [
        "working",
        "blocked",
        "done",
        "idle",
        "unknown"
      ]
    },
    "evidence_mode": {
      "const": "fixture"
    }
  },
  "required": [
    "schema_version",
    "session",
    "incarnation",
    "host",
    "server_incarnation",
    "pane",
    "state",
    "evidence_mode"
  ],
  "additionalProperties": false
}
