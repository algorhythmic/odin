{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:odin:memory-source:1",
  "type":"object","additionalProperties":false,
  "properties":{
    "id":{"type":"string","minLength":1},"project":{"type":"string","minLength":1},
    "revision":{"type":"integer","minimum":1},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "producer":{"type":"string","minLength":1},"source_class":{"type":"string","minLength":1},
    "locator":{"type":"string","minLength":1,"maxLength":1024},"span":{"type":["string","null"]},
    "readers":{"type":"array","uniqueItems":true,"maxItems":64,"items":{"type":"string","minLength":1}},
    "permissions_revision":{"type":"integer","minimum":1},
    "event_at":{"type":["string","null"],"format":"date-time"},
    "effective_at":{"type":["string","null"],"format":"date-time"},
    "observed_at":{"type":"string","format":"date-time"},
    "retrieved_at":{"type":"string","format":"date-time"},
    "ingest_seq":{"type":"integer","minimum":1},
    "content":{"type":"string","maxLength":8192}
  },
  "required":["id","project","revision","digest","producer","source_class","locator","span","readers","permissions_revision","event_at","effective_at","observed_at","retrieved_at","ingest_seq","content"]
}
