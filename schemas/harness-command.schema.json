{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "action", "host", "session", "generation", "assignment", "assignment_revision", "ownership_generation", "profile", "grant_id", "budget_ref", "credential_ref", "data_policy_ref", "deadline", "required_capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["start", "resume", "interrupt", "retire"]},
    "host": {"type": "string", "minLength": 1},
    "session": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "assignment": {"type": "string", "minLength": 1},
    "assignment_revision": {"type": "integer", "minimum": 1},
    "ownership_generation": {"type": "integer", "minimum": 1},
    "profile": {"enum": ["planner", "reviewer", "subagent"]},
    "grant_id": {"type": "string", "minLength": 1},
    "budget_ref": {"type": "string", "minLength": 1},
    "credential_ref": {"type": "string", "pattern": "^odin-harness:[A-Za-z0-9._/-]+$"},
    "data_policy_ref": {"type": "string", "minLength": 1},
    "deadline": {"type": "string", "format": "date-time"},
    "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["start", "resume", "interrupt", "retire", "transcript", "permission_relay", "profile_enforcement", "model_resolution", "effort_resolution", "budget_enforcement", "native_children", "credential_isolation"]}}
  }
}
