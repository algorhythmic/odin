{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "boundaries": {
      "type": "object",
      "properties": {
        "conversation": {
          "type": "string",
          "minLength": 1
        },
        "process": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "conversation",
        "process",
        "filesystem"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "string",
          "minLength": 1
        },
        "concurrency": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "budget",
        "concurrency",
        "depth"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "adapter",
    "version",
    "mode",
    "capabilities",
    "boundaries",
    "limits",
    "evidence",
    "gaps"
  ],
  "additionalProperties": false
}
