{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "action", "payload"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "action": {"const": "loop_capture"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "session_id", "hook_event_name"],
      "properties": {
        "project": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
        "session_id": {"type": "string", "format": "uuid"},
        "hook_event_name": {"enum": ["Stop", "StopFailure"]},
        "prompt_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "last_assistant_message": {"type": "string", "maxLength": 262144},
        "stop_hook_active": {"type": "boolean"},
        "error": {"type": "string", "maxLength": 128},
        "error_details": {"type": "string", "maxLength": 8000},
        "background_tasks": {
          "type": "array", "maxItems": 128,
          "items": {"type": "object"}
        },
        "session_crons": {
          "type": "array", "maxItems": 128,
          "items": {"type": "object"}
        }
      }
    }
  }
}
