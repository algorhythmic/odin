{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "position", "reviewer", "disposition", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "position": {"enum": ["reviewer", "operator"]},
    "reviewer": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["approve", "reject"]},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
