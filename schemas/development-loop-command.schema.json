{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "loop_start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "evidence_packet": {
          "type": "object"
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "no_progress_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "project",
        "goal",
        "session_id"
      ]
    },
    "loop_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "loop_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "project"
      ]
    },
    "loop_inbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "project",
        "session_id"
      ]
    },
    "loop_control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "loop_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "action": {
          "enum": [
            "pause",
            "resume",
            "stop"
          ]
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "project",
        "loop_id",
        "action"
      ]
    },
    "loop_reconcile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "loop_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "target": {
          "enum": [
            "evaluator",
            "executive"
          ]
        },
        "job_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "observed": {
          "enum": [
            "running",
            "not_started",
            "lost"
          ]
        }
      },
      "required": [
        "project",
        "loop_id",
        "target",
        "observed"
      ]
    },
    "loop_hold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "loop_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "project",
        "loop_id",
        "stage_id",
        "reason"
      ]
    },
    "loop_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "loop_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "project",
        "loop_id",
        "stage_id",
        "session_id"
      ]
    },
    "loop_ready": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "loop_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "evidence_packet": {
          "type": "object"
        }
      },
      "required": [
        "project",
        "loop_id",
        "stage_id",
        "session_id",
        "evidence_packet"
      ]
    }
  }
}
