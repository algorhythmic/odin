{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "usage_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "loop_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "project"
      ]
    },
    "usage_configure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "policy": {
          "type": "object"
        }
      },
      "required": [
        "project",
        "policy"
      ]
    },
    "usage_import": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object"
          }
        },
        "coverage": {
          "type": "object"
        }
      },
      "required": [
        "project",
        "source_id",
        "observations"
      ]
    },
    "context_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "predecessor": {
          "type": "boolean"
        }
      },
      "required": [
        "project"
      ]
    },
    "context_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint": {
          "type": "object"
        }
      },
      "required": [
        "project",
        "session_id",
        "checkpoint"
      ]
    }
  }
}
