{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "const": "fake-backend evidence"
    },
    "stopped": {
      "type": "boolean"
    },
    "dispatch_enabled": {
      "type": "boolean"
    },
    "records": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "reconciliation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "operation_id",
          "destination",
          "state",
          "reconciliation"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "label",
    "stopped",
    "dispatch_enabled",
    "records",
    "effects",
    "runs"
  ],
  "additionalProperties": false
}
