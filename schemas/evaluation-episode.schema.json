{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "fixture_digest": {
      "type": "string",
      "minLength": 1
    },
    "accepted": {
      "type": "boolean"
    },
    "failure": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_microusd": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "parent",
              "child",
              "reviewer",
              "integration",
              "recovery",
              "compactor",
              "evaluator",
              "tool",
              "repair"
            ]
          },
          "identity": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model_alias": {
                "type": "string",
                "minLength": 1
              },
              "resolved_model": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "harness": {
                "type": "string",
                "minLength": 1
              },
              "harness_version": {
                "type": "string",
                "minLength": 1
              },
              "adapter_version": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "provider",
              "model_alias",
              "resolved_model",
              "harness",
              "harness_version",
              "adapter_version",
              "effort"
            ],
            "additionalProperties": false
          },
          "context_digest": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cost_microusd": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "cache_read_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "cache_write_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "includes_operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missing_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "operation",
          "role",
          "identity",
          "context_digest",
          "tools",
          "cost_microusd",
          "input_tokens",
          "output_tokens",
          "cache_read_tokens",
          "cache_write_tokens",
          "includes_operations",
          "missing_reason"
        ],
        "additionalProperties": false
      }
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "limits": {
      "type": "object",
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "enforcement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "turns",
        "depth",
        "concurrency",
        "budget_microusd",
        "enforcement"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "briefing_digest": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_digest": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "briefing_digest",
        "retrieval_digest",
        "tools"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "result_status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "unknown"
      ]
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_lineage": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "held_out"
      ]
    },
    "operator_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "deadline_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "billing": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "fixture",
            "api",
            "subscription",
            "unknown"
          ]
        },
        "price_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "repriced": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "price_snapshot",
        "repriced"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "condition",
    "fixture_digest",
    "accepted",
    "failure",
    "cost_microusd",
    "cost_components",
    "elapsed_seconds",
    "limits",
    "context",
    "attempt",
    "result_status",
    "acceptance_evidence",
    "task_lineage",
    "split",
    "operator_seconds",
    "deadline_seconds",
    "billing"
  ],
  "additionalProperties": false
}
