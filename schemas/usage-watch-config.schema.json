{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "cursor_path", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "cursor_path": {"type": "string", "minLength": 1},
    "poll_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_chunk_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
    "max_files": {"type": "integer", "minimum": 1, "maximum": 256},
    "sources": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/source"}},
    "limit_probes": {"type": "object", "additionalProperties": false,
      "properties": {
        "claude_config_dir": {"type": "string", "minLength": 1},
        "codex_home": {"type": "string", "minLength": 1},
        "interval_seconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    },
    "status_files": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "agent_id", "account_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "executive_state": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["session_id"], "not": {"required": ["executive_state"]}},
        {"required": ["executive_state"], "not": {"required": ["session_id"]}}
      ]
    }}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {"enum": ["claude", "codex"]},
        "session_file": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "executive_state": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "sessions_dir": {"type": "string", "minLength": 1},
        "spool_dir": {"type": "string", "minLength": 1},
        "discover_jobs": {"type": "boolean"},
        "discover_sessions": {"type": "boolean"},
        "discover_children": {"type": "boolean"},
        "loop_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string", "minLength": 1},
        "usage_semantics": {"enum": ["per_turn", "session_cumulative"]}
      },
      "oneOf": [
        {"required": ["session_file", "session_id", "agent_id"], "not": {"anyOf": [{"required": ["sessions_dir"]}, {"required": ["spool_dir"]}, {"required": ["executive_state"]}]}},
        {"required": ["executive_state", "agent_id"], "properties": {"provider": {"const": "claude"}}, "not": {"anyOf": [{"required": ["session_file"]}, {"required": ["session_id"]}, {"required": ["sessions_dir"]}, {"required": ["spool_dir"]}]}},
        {"required": ["sessions_dir", "discover_sessions"], "properties": {"discover_sessions": {"const": true}}, "not": {"anyOf": [{"required": ["session_file"]}, {"required": ["spool_dir"]}, {"required": ["session_id"]}, {"required": ["executive_state"]}, {"required": ["loop_id"]}, {"required": ["stage_id"]}]}},
        {"required": ["spool_dir", "discover_jobs", "usage_semantics"], "properties": {"provider": {"const": "codex"}, "discover_jobs": {"const": true}, "usage_semantics": {"const": "session_cumulative"}}, "not": {"anyOf": [{"required": ["session_file"]}, {"required": ["sessions_dir"]}, {"required": ["session_id"]}, {"required": ["executive_state"]}, {"required": ["loop_id"]}, {"required": ["stage_id"]}, {"required": ["discover_children"]}]}}
      ]
    }
  }
}
