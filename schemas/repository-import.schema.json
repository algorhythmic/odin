{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:repository-import:1",
  "description": "Trusted operator upload of explicitly selected committed first-party repository text. Not a model-writable operation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 384
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "batch_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "batch_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 384
          },
          "chunk": {
            "type": "integer",
            "minimum": 0
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0
          },
          "byte_end": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "file_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        },
        "required": [
          "path",
          "chunk",
          "line_start",
          "line_end",
          "byte_start",
          "byte_end",
          "digest",
          "file_digest",
          "content"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "project",
    "repository",
    "commit",
    "snapshot_id",
    "captured_at",
    "file_count",
    "batch_index",
    "batch_digests",
    "entries"
  ]
}
