{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "label": {
      "const": "synthetic fixture"
    },
    "documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "digest",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "input",
          "criterion"
        ],
        "additionalProperties": false
      }
    },
    "integration_criterion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "label",
    "documents",
    "streams",
    "integration_criterion"
  ],
  "additionalProperties": false
}
