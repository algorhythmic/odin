{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "active",
        "closed"
      ]
    },
    "permits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "enum": [
              "Bash",
              "Write",
              "Edit",
              "NotebookEdit"
            ]
          },
          "input_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "enum": [
              "available",
              "admitted",
              "finished",
              "reconciled"
            ]
          },
          "tool_use_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        },
        "required": [
          "tool",
          "input_digest",
          "state",
          "tool_use_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "project",
    "session_id",
    "purpose",
    "created_at",
    "expires_at",
    "state",
    "permits"
  ],
  "additionalProperties": false
}
