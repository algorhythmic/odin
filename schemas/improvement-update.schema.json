{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "project", "scope", "kind", "version", "text", "source", "review_evidence", "regression_evidence", "non_authorizing"],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "scope": {"enum": ["project_fact", "response_style", "workflow_notes"]},
    "kind": {"enum": ["fact", "preference", "procedure"]},
    "version": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "review_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "regression_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_authorizing": {"const": true}
  }
}
