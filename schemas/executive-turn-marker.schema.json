{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "format": "uuid"},
    "event": {"enum": ["SessionStart", "UserPromptSubmit", "Stop", "StopFailure", "SessionEnd"]},
    "at": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "label": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"}]},
    "background_tasks": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
  },
  "required": ["schema_version", "session_id", "event", "at", "sequence", "label", "background_tasks"],
  "additionalProperties": false
}
