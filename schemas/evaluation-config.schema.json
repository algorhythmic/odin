{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment", "frozen_revision", "fixture_digest", "conditions"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "experiment": {"enum": ["semantic_memory", "compactor", "orchestration"]},
    "frozen_revision": {"type": "string", "minLength": 1},
    "fixture_digest": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "provider", "model", "effort", "harness", "harness_version", "adapter_version", "retriever_digest", "compactor_digest", "memory_features", "orchestration", "tools", "resource_policy_digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "effort": {"type": ["string", "null"]},
          "harness": {"type": "string", "minLength": 1},
          "harness_version": {"type": "string", "minLength": 1},
          "adapter_version": {"type": "string", "minLength": 1},
          "retriever_digest": {"type": "string", "minLength": 1},
          "compactor_digest": {"type": "string", "minLength": 1},
          "memory_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "orchestration": {"type": "string", "minLength": 1},
          "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "resource_policy_digest": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
