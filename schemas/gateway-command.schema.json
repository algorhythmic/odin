{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "action": {
      "enum": [
        "message",
        "status",
        "stop",
        "grant",
        "revoke",
        "handoff",
        "accept_handoff",
        "report",
        "portfolio",
        "consult_start",
        "consult_response",
        "consult_late",
        "consult_close",
        "consult_followup",
        "consult_status",
        "consult_end",
        "session_intent",
        "layout_bind",
        "layout_observe",
        "consult_usage",
        "resume",
        "prepare_decision",
        "answer_decision",
        "view_delivery",
        "view_ack",
        "memory_snapshot",
        "memory_source_read",
        "executive_report",
        "executive_reports",
        "repository_import",
        "delegation_session",
        "delegation_assign",
        "delegation_followup",
        "delegation_status",
        "delegation_result",
        "delegation_close",
        "loop_start",
        "loop_status",
        "loop_inbox",
        "loop_claim",
        "loop_ready",
        "loop_capture",
        "loop_control",
        "loop_continue",
        "loop_reconcile",
        "loop_ack",
        "loop_hold",
        "loop_handover",
        "loop_delegate",
        "usage_import",
        "usage_status",
        "usage_configure",
        "context_checkpoint",
        "context_status",
        "intervention_begin",
        "intervention_end",
        "intervention_status",
        "intervention_authorize",
        "intervention_finish",
        "intervention_reconcile",
        "executive_restart_request",
        "executive_restart_status",
        "executive_restart_transition",
        "executive_supervisor_event",
        "runtime_deploy_request",
        "runtime_deploy_transition"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "action",
    "payload"
  ],
  "additionalProperties": false
}
