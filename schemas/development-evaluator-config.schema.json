{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "harness": {
      "enum": [
        "codex",
        "claude-code"
      ]
    },
    "binary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "config_dir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    }
  },
  "required": [
    "schema_version",
    "enabled",
    "harness",
    "binary",
    "workspace",
    "config_dir",
    "model",
    "timeout_seconds"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:development-evaluator-config:1",
  "$defs": {
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "packet_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "spec_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "reserved",
            "spawned"
          ]
        },
        "runner_pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "runner_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "packet_digest",
        "spec_digest",
        "attempt",
        "state",
        "runner_pid",
        "runner_start",
        "created_at"
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "turn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "harness": {
          "enum": [
            "codex",
            "claude-code"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32000
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "output_format": {
          "enum": [
            "json",
            "jsonl"
          ]
        },
        "last_message_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "const": "exclusive"
            },
            "lock": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/"
            },
            "shared_with": {
              "type": "null"
            },
            "credential_file": {
              "type": "null"
            }
          },
          "required": [
            "policy",
            "lock",
            "shared_with",
            "credential_file"
          ]
        }
      },
      "required": [
        "schema_version",
        "turn",
        "harness",
        "argv",
        "cwd",
        "env",
        "timeout_seconds",
        "output_format",
        "last_message_file",
        "lineage"
      ]
    },
    "started": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "runner_pid": {
          "type": "integer",
          "minimum": 1
        },
        "harness_pid": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "harness_start": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "runner_pid",
        "harness_pid",
        "started_at"
      ]
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "requested_at"
      ]
    }
  }
}
