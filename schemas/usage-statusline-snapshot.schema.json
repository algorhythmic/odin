{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:usage-statusline-snapshot:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "context_window", "rate_limits"],
  "properties": {
    "session_id": {"type": "string", "format": "uuid"},
    "context_window": {
      "type": "object", "additionalProperties": false,
      "required": ["context_window_size", "current_usage"],
      "properties": {
        "context_window_size": {"$ref": "#/$defs/count"},
        "current_usage": {
          "anyOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false,
             "required": ["input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"],
             "properties": {
               "input_tokens": {"$ref": "#/$defs/count"},
               "cache_creation_input_tokens": {"$ref": "#/$defs/count"},
               "cache_read_input_tokens": {"$ref": "#/$defs/count"}
             }}
          ]
        }
      }
    },
    "rate_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["five_hour", "seven_day"],
      "properties": {
        "five_hour": {"$ref": "#/$defs/rate"},
        "seven_day": {"$ref": "#/$defs/rate"}
      }
    }
  },
  "$defs": {
    "count": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
    "rate": {
      "type": "object", "additionalProperties": false,
      "required": ["used_percentage", "resets_at"],
      "properties": {
        "used_percentage": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "null"}]},
        "resets_at": {"$ref": "#/$defs/count"}
      }
    }
  }
}
