{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["hooks"],
  "properties": {
    "crossSessionInbound": {"const": "accept"},
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Stop", "StopFailure"],
      "properties": {
        "Stop": {"$ref": "#/$defs/event"},
        "StopFailure": {"$ref": "#/$defs/event"}
      }
    }
  },
  "$defs": {
    "event": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hooks"],
        "properties": {
          "hooks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "command", "args", "timeout"],
              "properties": {
                "type": {"const": "command"},
                "command": {"const": "/usr/bin/env"},
                "timeout": {"const": 5},
                "args": {
                  "type": "array",
                  "minItems": 11,
                  "maxItems": 11,
                  "prefixItems": [
                    {"type": "string", "pattern": "^PYTHONPATH=/"},
                    {"const": "PYTHONNOUSERSITE=1"},
                    {"type": "string", "pattern": "^/"},
                    {"const": "-m"},
                    {"const": "odin.executive_loop_hook"},
                    {"const": "--state"},
                    {"type": "string", "pattern": "^/"},
                    {"const": "--project"},
                    {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
                    {"const": "--session-id"},
                    {"type": "string", "format": "uuid"}
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
