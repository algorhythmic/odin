{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:development-loop-stage:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "loop_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "state": {
      "enum": [
        "pending",
        "claimed",
        "ready",
        "completed",
        "cancelled",
        "unknown"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "source_job": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ]
    },
    "completion_marker": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 262144
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "prompt_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "unknown_from": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
,
    "receipt_validation": {
      "type": "object",
      "required": ["status", "receipts", "problems"],
      "properties": {
        "status": {"enum": ["validated", "invalid", "missing", "mismatched", "legacy_no_receipt"]},
        "receipts": {"type": "array"},
        "problems": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "loop_id",
    "project",
    "session_id",
    "round",
    "state",
    "prompt",
    "source_job",
    "source_packet_digest",
    "evidence",
    "completion_marker",
    "final_digest",
    "final_text",
    "created_at",
    "prompt_id",
    "unknown_from"
  ],
  "additionalProperties": false
}
