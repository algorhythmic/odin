{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment", "frozen_revision", "label", "lineages", "conditions", "ranking"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "experiment": {"enum": ["semantic_memory", "compactor", "orchestration"]},
    "frozen_revision": {"type": "string", "minLength": 1},
    "label": {"const": "offline fixture analysis"},
    "lineages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["project", "task_lineage"], "properties": {"project": {"type": "string", "minLength": 1}, "task_lineage": {"type": "string", "minLength": 1}}}},
    "conditions": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "accounting", "attention", "known_operator_seconds", "missing_operator_time", "incomplete_token_episodes", "task_elapsed_seconds", "deadline_successes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "accounting": {"type": "object"},
        "attention": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "known_operator_seconds": {"type": "number", "minimum": 0},
        "missing_operator_time": {"type": "integer", "minimum": 0},
        "incomplete_token_episodes": {"type": "integer", "minimum": 0},
        "task_elapsed_seconds": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "deadline_successes": {"type": "integer", "minimum": 0}
      }
    }},
    "ranking": {"type": "null"}
  }
}
