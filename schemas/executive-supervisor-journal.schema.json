{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "code": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "time",
    "kind"
  ],
  "additionalProperties": false
}
