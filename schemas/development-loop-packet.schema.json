{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:development-loop-packet:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "loop_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "loop_revision": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "executive_final_text": {
      "type": "string",
      "maxLength": 262144
    },
    "evidence": {
      "type": "object"
    },
    "previous_assessment": {
      "type": [
        "object",
        "null"
      ]
    }
,
    "receipt_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipts", "problems", "commands_succeeded"],
      "properties": {
        "status": {"enum": ["validated", "validated_unobserved", "uncertain", "invalid", "missing", "mismatched", "legacy_no_receipt"]},
        "commands_succeeded": {"type": ["boolean", "null"]},
        "receipts": {"type": "array", "maxItems": 16, "items": {"type": "object"}},
        "problems": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 1400}}
      }
    }
  },
  "required": [
    "schema_version",
    "loop_id",
    "project",
    "session_id",
    "round",
    "loop_revision",
    "goal",
    "executive_final_text",
    "evidence",
    "previous_assessment"
  ],
  "additionalProperties": false
}
