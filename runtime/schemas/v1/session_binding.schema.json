{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.invalid/schemas/v1/session_binding.schema.json",
  "title": "Session Binding",
  "description": "",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "assignment",
            "planning_session"
          ]
        },
        "id": {
          "$ref": "common.schema.json#/$defs/ulid"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "harness": {
      "type": "string",
      "minLength": 1
    },
    "native_session_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "incarnation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "host_offline",
        "invalidated"
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ulid"
        },
        "rev": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "rev"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "workspace": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "server_incarnation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pane": {
          "$ref": "common.schema.json#/$defs/opaque_id"
        }
      },
      "required": [
        "host",
        "server_incarnation",
        "pane"
      ],
      "additionalProperties": false
    },
    "predecessor": {
      "$ref": "common.schema.json#/$defs/ulid"
    }
  },
  "required": [
    "id",
    "rev",
    "created_at",
    "updated_at",
    "subject",
    "harness",
    "native_session_id",
    "host",
    "incarnation",
    "state",
    "environment",
    "capabilities"
  ],
  "additionalProperties": false
}
