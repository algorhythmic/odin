{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.invalid/schemas/v1/assignment.schema.json",
  "title": "Assignment",
  "description": "Saga run IDs are opaque; request_id is Odin-preallocated by stage_run. A drafted Saga assignment can exist before staging. Local and desktop assignments have no Saga run/request binding.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "commitment": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "commitment_rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        },
        "required": [
          "ref",
          "digest"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "output_contract": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "backend": {
      "type": "string",
      "enum": [
        "saga",
        "local",
        "desktop"
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "budget_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "iterations",
        "budget_usd"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "drafted",
        "approved",
        "dispatched",
        "active",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "run": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/ulid"
    }
  },
  "required": [
    "id",
    "rev",
    "created_at",
    "updated_at",
    "commitment",
    "commitment_rev",
    "inputs",
    "scope",
    "output_contract",
    "owner",
    "backend",
    "limits",
    "state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "enum": [
              "local",
              "desktop"
            ]
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "run"
              ]
            },
            {
              "required": [
                "request_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "backend": {
                "const": "saga"
              }
            },
            "required": [
              "backend"
            ]
          },
          {
            "properties": {
              "state": {
                "enum": [
                  "approved",
                  "dispatched",
                  "active",
                  "completed"
                ]
              }
            },
            "required": [
              "state"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "request_id"
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "backend": {
                "const": "saga"
              }
            },
            "required": [
              "backend"
            ]
          },
          {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "completed"
                ]
              }
            },
            "required": [
              "state"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "run",
          "request_id"
        ]
      }
    }
  ]
}
