{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.invalid/schemas/v1/semantics.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "intake",
              "revision",
              "owner",
              "reconcile"
            ]
          },
          "input": {
            "type": "object"
          },
          "expected": {}
        },
        "required": [
          "name",
          "operation",
          "input",
          "expected"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "operation": {
                "const": "intake"
              },
              "input": {
                "type": "object",
                "properties": {
                  "last_sequence": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "incoming_sequence": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "dedupe_seen": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "last_sequence",
                  "incoming_sequence",
                  "dedupe_seen"
                ],
                "additionalProperties": false
              },
              "expected": {
                "enum": [
                  "new",
                  "duplicate"
                ]
              }
            }
          },
          {
            "properties": {
              "operation": {
                "const": "revision"
              },
              "input": {
                "type": "object",
                "properties": {
                  "expected": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "actual": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "expected",
                  "actual"
                ],
                "additionalProperties": false
              },
              "expected": {
                "enum": [
                  "ok",
                  "stale_revision"
                ]
              }
            }
          },
          {
            "properties": {
              "operation": {
                "const": "owner"
              },
              "input": {
                "type": "object",
                "properties": {
                  "expected_generation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "actual_generation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "expected_generation",
                  "actual_generation"
                ],
                "additionalProperties": false
              },
              "expected": {
                "enum": [
                  "ok",
                  "stale_owner"
                ]
              }
            }
          },
          {
            "properties": {
              "operation": {
                "const": "reconcile"
              },
              "input": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "completed",
                      "pending",
                      "failed",
                      "superseded",
                      "absent",
                      "unknown_expired"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              "expected": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "delivered",
                      "unknown",
                      "failed",
                      "superseded"
                    ]
                  },
                  "action": {
                    "enum": [
                      "none",
                      "wait",
                      "retry_after_revalidation",
                      "surface_to_operator"
                    ]
                  }
                },
                "required": [
                  "state",
                  "action"
                ],
                "additionalProperties": false
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "cases"
  ],
  "additionalProperties": false
}
