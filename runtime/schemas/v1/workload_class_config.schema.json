{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.invalid/schemas/v1/workload_class_config.schema.json",
  "title": "Workload class configuration v1",
  "description": "Schema home for configured classes, not a fixed class enum or prescribed model defaults. Profile is an independent tool-permission category.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "config_rev": {
      "type": "string",
      "minLength": 1
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          },
          "budget_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "profile": {
            "type": "string",
            "enum": [
              "planner",
              "reviewer",
              "worker",
              "desktop_worker",
              "subagent"
            ]
          }
        },
        "required": [
          "name",
          "model",
          "effort",
          "budget_usd",
          "required_capabilities",
          "profile"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "selection_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_kind": {
            "type": "string",
            "minLength": 1
          },
          "assignment_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "class": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "event_kind",
          "assignment_requirements",
          "class"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "config_rev",
    "classes",
    "selection_rules"
  ],
  "additionalProperties": false
}
