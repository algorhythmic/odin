{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.invalid/schemas/v1/environment.schema.json",
  "title": "Environment",
  "description": "Only credential references and refresher identities, never credential material.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "host_incarnation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "probed_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "probe_version": {
      "type": "string",
      "minLength": 1
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "herdr": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "type": "string",
              "enum": [
                "local",
                "ssh_machine"
              ]
            }
          },
          "required": [
            "version",
            "access"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "isolation": {
      "type": "object",
      "properties": {
        "sandbox": {
          "type": "string",
          "minLength": 1
        },
        "planner_workspace": {
          "type": "boolean"
        }
      },
      "required": [
        "sandbox",
        "planner_workspace"
      ],
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "credential_lineages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "common.schema.json#/$defs/credential_ref"
          },
          "mode": {
            "type": "string",
            "enum": [
              "api",
              "subscription",
              "local"
            ]
          },
          "refresher": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ref",
          "mode",
          "refresher"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "id",
    "rev",
    "created_at",
    "updated_at",
    "host",
    "host_incarnation",
    "probed_at",
    "probe_version",
    "harnesses",
    "herdr",
    "isolation",
    "surfaces",
    "sensors",
    "credential_lineages"
  ],
  "additionalProperties": false
}
