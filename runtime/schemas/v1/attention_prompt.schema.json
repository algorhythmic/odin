{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.invalid/schemas/v1/attention_prompt.schema.json",
  "title": "Attention Prompt",
  "description": "",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "effect": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "project": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "commitment",
            "session"
          ]
        },
        "id": {
          "$ref": "common.schema.json#/$defs/ulid"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence_ref"
      },
      "minItems": 1
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "coalescing_key": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "shadow",
        "live"
      ]
    },
    "cap_state": {
      "type": "object",
      "properties": {
        "surface_today": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "all_today": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "surface_today",
        "all_today"
      ],
      "additionalProperties": false
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "state": {
      "type": "string",
      "enum": [
        "logged",
        "queued",
        "delivered",
        "responded",
        "expired"
      ]
    },
    "response": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "done",
                "snooze",
                "dismiss",
                "override",
                "expired"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "until": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/utc_timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "by": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "at": {
              "$ref": "common.schema.json#/$defs/utc_timestamp"
            },
            "source_event": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "snooze"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "until"
                ],
                "properties": {
                  "until": {
                    "$ref": "common.schema.json#/$defs/utc_timestamp"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "override"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "done",
                      "snooze",
                      "dismiss",
                      "override"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "by",
                  "source_event"
                ],
                "properties": {
                  "by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_event": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "rev",
    "created_at",
    "updated_at",
    "effect",
    "project",
    "subject",
    "proposal",
    "evidence",
    "surface",
    "rule",
    "coalescing_key",
    "mode",
    "cap_state",
    "expires_at",
    "state",
    "response"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "responded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "response"
        ],
        "properties": {
          "response": {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "done",
                      "snooze",
                      "dismiss",
                      "override",
                      "expired"
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "until": {
                    "anyOf": [
                      {
                        "$ref": "common.schema.json#/$defs/utc_timestamp"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "by": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "at": {
                    "$ref": "common.schema.json#/$defs/utc_timestamp"
                  },
                  "source_event": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "at"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "snooze"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "until"
                      ],
                      "properties": {
                        "until": {
                          "$ref": "common.schema.json#/$defs/utc_timestamp"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "override"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "reason"
                      ],
                      "properties": {
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "enum": [
                            "done",
                            "snooze",
                            "dismiss",
                            "override"
                          ]
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "by",
                        "source_event"
                      ],
                      "properties": {
                        "by": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_event": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "done",
                      "snooze",
                      "dismiss",
                      "override"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "expired"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "response"
        ],
        "properties": {
          "response": {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "done",
                      "snooze",
                      "dismiss",
                      "override",
                      "expired"
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "until": {
                    "anyOf": [
                      {
                        "$ref": "common.schema.json#/$defs/utc_timestamp"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "by": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "at": {
                    "$ref": "common.schema.json#/$defs/utc_timestamp"
                  },
                  "source_event": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "at"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "snooze"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "until"
                      ],
                      "properties": {
                        "until": {
                          "$ref": "common.schema.json#/$defs/utc_timestamp"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "override"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "reason"
                      ],
                      "properties": {
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "enum": [
                            "done",
                            "snooze",
                            "dismiss",
                            "override"
                          ]
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "by",
                        "source_event"
                      ],
                      "properties": {
                        "by": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_event": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              },
              {
                "properties": {
                  "kind": {
                    "const": "expired"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "logged",
              "queued",
              "delivered"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "response": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "shadow"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "logged",
              "expired"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "queued",
              "delivered",
              "responded",
              "expired"
            ]
          }
        }
      }
    }
  ]
}
